{
  "name": "review-summerizer",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run --cwd packages/server index.ts",
    "dev:client": "bun run --cwd packages/client dev",
    "build": "bun run --cwd packages/client build",
    "typecheck:server": "bun run --cwd packages/server tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ]
}
